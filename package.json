{
  "name": "ireland-trip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maplibre-gl-worker.mjs')\" && node scripts/build-family-icons.mjs",
    "dev": "next dev",
    "prebuild": "node -e \"require('fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maplibre-gl-worker.mjs')\" && node scripts/build-family-icons.mjs",
    "build": "next build",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "test": "node --test lib/*.test.ts",
    "test:duel-db": "node scripts/test-duel-db.mjs",
    "test:pk-db": "node scripts/test-pk-db.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.58.0",
    "maplibre-gl": "^6.14.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
